---
import '../styles/global.css';
import SiteNav from '../components/SiteNav';
import SkillsTags from '../components/SkillsTags';
import WorkProjects from '../components/WorkProjects.astro';

const title = 'Keisei Kondo | Full-Stack Developer';
const description =
  'Keisei Kondo — full-stack developer in Vancouver. TypeScript, React, Next.js, Astro, and Node. Open to full-time roles from January 2027.';
const site = Astro.site ?? new URL('https://keisei-portfolio.vercel.app');
const pageUrl = new URL('/', site).href;
const imageUrl = new URL('/og.png', site).href;
const resumeUrl = '/Keisei_Kondo_Resume.pdf';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Keisei Kondo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Keisei Kondo — Full-Stack Developer in Vancouver" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content="Keisei Kondo — Full-Stack Developer in Vancouver" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="site-header">
      <a class="brand" href="#hero">
        <span class="brand__name">keisei kondo</span>
        <span class="brand__tag">full-stack developer</span>
      </a>
      <SiteNav />
    </header>

    <main id="main-content">
      <section class="hero" id="hero" aria-labelledby="hero-heading">
        <div class="hero-field" aria-hidden="true">
          <div class="hero-field__glow"></div>
          <div class="hero-field__layer hero-field__layer--far">
            <div class="hero-field__dust hero-field__dust--far"></div>
          </div>
          <div class="hero-field__layer hero-field__layer--mid">
            <div class="hero-field__dust hero-field__dust--mid"></div>
          </div>
          <div class="hero-field__layer hero-field__layer--near">
            <div class="hero-field__dust hero-field__dust--near"></div>
          </div>
        </div>
        <div class="hero-layout">
          <div class="hero-copy">
            <p class="eyebrow">Keisei Kondo / Full-Stack Developer</p>
            <h1 id="hero-heading" class="hero-title">
              <span>Full-Stack</span>
              <span class="hero-title__fade">Developer</span>
            </h1>
            <p class="hero-intro">
              I build full-stack TypeScript apps — clear UI, working APIs, production-ready detail.
              Open to full-time roles from January 2027 in Vancouver.
            </p>
            <div class="hero-actions">
              <a class="btn btn--solid" href={resumeUrl} target="_blank" rel="noopener noreferrer">Resume</a>
              <a class="btn btn--line" href="#contact">Contact</a>
              <a class="btn btn--text" href="https://github.com/keisei-dev" target="_blank" rel="noopener noreferrer">GitHub</a>
            </div>
          </div>
          <div class="hero-stage">
            <div class="hero-deck" data-hero-deck>
              <div class="hero-deck__tabs" role="tablist" aria-label="Selected work">
                <button
                  type="button"
                  role="tab"
                  id="deck-tab-0"
                  aria-selected="true"
                  aria-controls="deck-panel"
                  data-title="Trim Team Booking"
                  data-host="trim-team.vercel.app"
                  data-kicker="Shipped"
                  data-copy="Staff dashboard. Customers book without an account."
                  data-href="https://trim-team.vercel.app"
                  data-label="Live site"
                >Trim</button>
                <button
                  type="button"
                  role="tab"
                  id="deck-tab-1"
                  aria-selected="false"
                  tabindex="-1"
                  aria-controls="deck-panel"
                  data-title="Unsplash Landing"
                  data-host="unsplash-keisei.vercel.app"
                  data-kicker="Shipped"
                  data-copy="A typed recreation of the Unsplash landing page."
                  data-href="https://unsplash-keisei.vercel.app"
                  data-label="Live site"
                >Unsplash</button>
                <button
                  type="button"
                  role="tab"
                  id="deck-tab-2"
                  aria-selected="false"
                  tabindex="-1"
                  aria-controls="deck-panel"
                  data-title="Player Performance"
                  data-host="github.com/keisei-dev"
                  data-kicker="Individual"
                  data-copy="World Cup player data, search, filters, and rankings."
                  data-href="https://github.com/keisei-dev/player-stats"
                  data-label="GitHub"
                >Explorer</button>
                <button
                  type="button"
                  role="tab"
                  id="deck-tab-3"
                  aria-selected="false"
                  tabindex="-1"
                  aria-controls="deck-panel"
                  data-title="Real-Time Chat"
                  data-host="socket.io"
                  data-kicker="Team"
                  data-copy="Rooms, copy, and unsend on Express and Socket.IO."
                  data-href="https://github.com/Cornerstone-CICCC/final-project-full-stack-real-time-app-patrick-kingdom"
                  data-label="GitHub"
                >Chat</button>
                <span class="hero-deck__underline" data-deck-underline aria-hidden="true"></span>
              </div>
              <div class="hero-deck__stage">
                <div class="hero-deck__pile">
                  <div class="hero-deck__card hero-deck__card--back" aria-hidden="true"></div>
                  <div class="hero-deck__card hero-deck__card--mid" aria-hidden="true"></div>
                  <article
                    class="hero-deck__card hero-deck__card--front"
                    id="deck-panel"
                    role="tabpanel"
                    aria-labelledby="deck-tab-0"
                  >
                    <div class="hero-deck__face">
                      <header class="hero-deck__bar">
                        <span></span><span></span><span></span>
                        <p data-deck-host>trim-team.vercel.app</p>
                      </header>
                      <p class="hero-deck__kicker" data-deck-kicker>Shipped</p>
                      <h2 data-deck-title>Trim Team Booking</h2>
                      <div class="hero-deck__rows" aria-hidden="true">
                        <i></i><i></i><i></i>
                      </div>
                    </div>
                  </article>
                </div>
              </div>
              <p class="hero-deck__caption">
                <span data-deck-copy>Staff dashboard. Customers book without an account.</span>
                <a data-deck-link href="https://trim-team.vercel.app" target="_blank" rel="noopener noreferrer">Live site</a>
              </p>
            </div>
          </div>
        </div>
        <div class="hero-foot">
          <p>Full-Stack / React / Node.js / TypeScript</p>
          <a href="#about">scroll <span aria-hidden="true">↓</span></a>
        </div>
      </section>

      <section class="panel" id="about" aria-labelledby="about-heading">
        <div class="panel-body about-body" data-panel data-about>
          <header class="section-head">
            <h2 id="about-heading"><span class="kicker">01 —</span> About</h2>
          </header>

          <div class="about-grid" data-about-scrub>
            <span class="about-line about-line--h" aria-hidden="true"></span>
            <div class="about-rail" data-reveal style="--reveal-delay: 0.08s">
              <p class="about-name">Keisei Kondo</p>
              <p class="about-meta">
                Vancouver · From Jan 2027
              </p>
              <p class="about-focus">Full-Stack Developer</p>
            </div>

            <div class="about-copy" data-about-copy>
              <span class="about-line about-line--v" aria-hidden="true"></span>
              <p class="copy">
                Web development student at
                <span class="hl">CICCC</span> in Vancouver, building
                <span class="hl">full-stack TypeScript</span> applications.
              </p>
              <p class="copy">
                Shipped work with
                <span class="hl">Next.js</span>,
                <span class="hl">Astro</span>, and
                <span class="hl">React</span> on the front end, and
                <span class="hl">Express</span>,
                <span class="hl">Socket.IO</span>, and
                <span class="hl">PostgreSQL</span> on the back end.
                I use <span class="hl">Git and GitHub</span> and ship to Vercel.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="panel" id="skills" aria-labelledby="skills-heading">
        <div class="panel-body panel-body--wide" data-panel>
          <header class="section-head">
            <h2 id="skills-heading"><span class="kicker">02 —</span> Skills</h2>
          </header>
          <SkillsTags />
        </div>
      </section>

      <WorkProjects />

      <section class="panel" id="contact" aria-labelledby="contact-heading">
        <div class="panel-body contact-body" data-panel>
          <header class="section-head">
            <h2 id="contact-heading"><span class="kicker">04 —</span> Contact</h2>
          </header>
          <div class="contact-grid">
            <div class="contact-identity">
              <p class="contact-name">Keisei Kondo</p>
              <p class="contact-meta">Vancouver · From Jan 2027</p>
              <p class="contact-lead">
                Hiring a full-stack developer in Vancouver? I'd like to hear about the role.
              </p>
            </div>
            <ul class="contact-links" role="list">
              <li>
                <a class="contact-link" href="mailto:keisei20001206@gmail.com">
                  <span class="contact-link__label">Email</span>
                  <span class="contact-link__value">keisei20001206@gmail.com</span>
                </a>
              </li>
              <li>
                <a
                  class="contact-link"
                  href="https://github.com/keisei-dev"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class="contact-link__label">GitHub</span>
                  <span class="contact-link__value">keisei-dev</span>
                </a>
              </li>
              <li>
                <a
                  class="contact-link"
                  href="https://www.linkedin.com/in/keisei-kondo-0bab093a3"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class="contact-link__label">LinkedIn</span>
                  <span class="contact-link__value">keisei-kondo</span>
                </a>
              </li>
              <li>
                <a class="contact-link" href={resumeUrl} target="_blank" rel="noopener noreferrer">
                  <span class="contact-link__label">Resume</span>
                  <span class="contact-link__value">PDF</span>
                </a>
              </li>
            </ul>
          </div>
        </div>
        <p class="footer">© Keisei Kondo</p>
      </section>
    </main>

    <script>
      import '../main.ts';
    </script>
  </body>
</html>
