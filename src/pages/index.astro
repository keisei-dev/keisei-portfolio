---
import '../styles/global.css';
import SiteNav from '../components/SiteNav';
import SkillsTags from '../components/SkillsTags';
import ContactSignal from '../components/ContactSignal';
import WorkProjects from '../components/WorkProjects.astro';

const title = 'Keisei Kondo | Full-Stack Developer';
const description =
  'Keisei Kondo — full-stack developer in Vancouver. TypeScript, React, Next.js, Astro, and Node. Open to full-time roles from January 2027.';
const site = Astro.site ?? new URL('https://keisei-portfolio.vercel.app');
const pageUrl = new URL('/', site).href;
const imageUrl = new URL('/og.png', site).href;
const resumeUrl = '/Keisei_Kondo_Resume.pdf';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Keisei Kondo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Keisei Kondo — Full-Stack Developer in Vancouver" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content="Keisei Kondo — Full-Stack Developer in Vancouver" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600;700&family=DM+Mono:wght@300;400&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <canvas id="bg" aria-hidden="true"></canvas>

    <header class="site-header">
      <a class="logo" href="#hero">KEISEI</a>
      <SiteNav client:load />
    </header>

    <main id="main-content">
      <section class="hero" id="hero" aria-labelledby="hero-heading">
        <div class="hero-content" data-hero>
          <p class="hero-eyebrow">
            <span class="hero-pulse" aria-hidden="true"></span>
            Open to full-time roles · Jan 2027 · Vancouver
          </p>
          <h1 id="hero-heading" class="hero-title">
            <span class="visually-hidden">Full-Stack Developer</span>
            <canvas class="hero-star-title" data-hero-stars aria-hidden="true"></canvas>
          </h1>
          <div class="hero-lower" data-hero-line>
            <p class="hero-lead">
              I build full-stack TypeScript apps — clear UI, working APIs, production-ready detail.
            </p>
            <div class="hero-actions">
              <a class="hero-cta" href="#contact">
                <span class="hero-cta__label">Contact me</span>
                <span class="hero-cta__icon" aria-hidden="true">
                  <span class="hero-cta__chevron"></span>
                </span>
              </a>
              <a class="hero-link" href="#projects">See my work</a>
              <a
                class="hero-link"
                href={resumeUrl}
                target="_blank"
                rel="noopener noreferrer"
                >Resume</a
              >
            </div>
          </div>
        </div>
        <a class="hero-scroll" href="#about" aria-label="Scroll to about">
          <span class="hero-scroll__label">Scroll</span>
          <span class="hero-scroll__line" aria-hidden="true"></span>
        </a>
      </section>

      <section class="panel" id="about" aria-labelledby="about-heading">
        <div class="panel-body about-body" data-panel data-about>
          <header class="section-head" data-reveal>
            <h2 id="about-heading">About</h2>
          </header>

          <div class="about-grid">
            <div class="about-rail" data-reveal style="--reveal-delay: 0.08s">
              <p class="about-name">Keisei Kondo</p>
              <p class="about-meta">
                Vancouver · JA / EN · From Jan 2027
              </p>
              <p class="about-focus">Full-Stack Developer</p>
            </div>

            <div
              class="about-copy prose-copy"
              data-prose-copy
              data-reveal
              style="--reveal-delay: 0.16s"
            >
              <p class="copy prose-line" style="--l: 0">
                Web development student at
                <span class="hl">CICCC</span> in Vancouver, building
                <span class="hl">full-stack TypeScript</span> applications.
              </p>
              <p class="copy prose-line" style="--l: 1">
                Shipped work with
                <span class="hl">Next.js</span>,
                <span class="hl">Astro</span>, and
                <span class="hl">React</span> on the front end, and
                <span class="hl">Express</span>,
                <span class="hl">Socket.IO</span>, and
                <span class="hl">PostgreSQL</span> on the back end.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="panel" id="skills" aria-labelledby="skills-heading">
        <div class="panel-body panel-body--wide" data-panel>
          <header class="section-head" data-reveal>
            <h2 id="skills-heading">Skills</h2>
          </header>
          <SkillsTags />
        </div>
        <div class="marquee" aria-hidden="true">
          <div class="marquee-track">
            <span>TypeScript ✦ React ✦ Next.js ✦ Astro ✦ Node.js ✦ PostgreSQL ✦ </span>
            <span>TypeScript ✦ React ✦ Next.js ✦ Astro ✦ Node.js ✦ PostgreSQL ✦ </span>
          </div>
        </div>
      </section>

      <WorkProjects />

      <section class="panel" id="value" aria-labelledby="value-heading">
        <div class="panel-body" data-panel>
          <header class="section-head" data-reveal>
            <h2 id="value-heading">Value</h2>
          </header>
          <p class="lead prose-lead" data-words>What I bring to a team.</p>

          <div class="value-ticker" data-reveal style="--reveal-delay: 0.12s" aria-hidden="true">
            <div class="value-ticker__track">
              <span>TypeScript</span>
              <span>Collaboration</span>
              <span>Git</span>
              <span>Full-stack</span>
              <span>PostgreSQL</span>
              <span>Vercel</span>
              <span>TypeScript</span>
              <span>Collaboration</span>
              <span>Git</span>
              <span>Full-stack</span>
              <span>PostgreSQL</span>
              <span>Vercel</span>
            </div>
          </div>

          <div class="prose-copy" data-prose-copy data-reveal style="--reveal-delay: 0.2s">
            <p class="copy prose-line" style="--l: 0">
              Team development with
              <span class="hl">Git and GitHub</span>, shipping
              <span class="hl">Next.js</span>,
              <span class="hl">Astro</span>, and
              <span class="hl">Express</span> apps to Vercel.
            </p>
            <p class="copy prose-line" style="--l: 1">
              I communicate in
              <span class="hl">Japanese (native)</span> and
              <span class="hl">English</span>, and I'm open to full-time roles from January 2027.
            </p>
          </div>
        </div>
      </section>

      <section class="panel gas-panel" id="contact" aria-labelledby="contact-heading">
        <div class="panel-body" data-panel>
          <header class="section-head" data-reveal>
            <h2 id="contact-heading">Contact</h2>
          </header>
          <p class="lead prose-lead" data-words>Available for full-time roles from January 2027.</p>
          <div class="prose-copy" data-prose-copy data-reveal style="--reveal-delay: 0.2s">
            <p class="copy prose-line" style="--l: 0">
              Hiring a
              <span class="hl">full-stack developer</span> in
              <span class="hl">Vancouver</span>?
            </p>
            <p class="copy prose-line" style="--l: 1">
              I'd like to hear about the role — interviews, take-homes, and next steps welcome.
            </p>
          </div>
          <div class="contact-actions" data-reveal style="--reveal-delay: 0.16s">
            <ContactSignal client:load />
            <ul class="contact-links" role="list">
              <li>
                <a class="contact-link" href={resumeUrl} target="_blank" rel="noopener noreferrer"
                  >Resume</a
                >
              </li>
              <li>
                <a
                  class="contact-link"
                  href="https://www.linkedin.com/in/keisei-kondo-0bab093a3"
                  target="_blank"
                  rel="noopener noreferrer"
                  >LinkedIn</a
                >
              </li>
              <li>
                <a
                  class="contact-link"
                  href="https://github.com/keisei-dev"
                  target="_blank"
                  rel="noopener noreferrer"
                  >GitHub</a
                >
              </li>
            </ul>
          </div>
        </div>
        <p class="footer">© Keisei Kondo</p>
      </section>
    </main>

    <script>
      import '../main.ts';
    </script>
  </body>
</html>
