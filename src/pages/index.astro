---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Portfolio of Keisei Kondo — full-stack developer. TypeScript, Node.js, PostgreSQL, Astro, and Three.js."
    />
    <title>Keisei Kondo | Portfolio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600;700&family=DM+Mono:wght@300;400&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <canvas id="bg" aria-hidden="true"></canvas>

    <header class="site-header">
      <a class="logo" href="#">KEISEI</a>
      <div class="nav-wrap">
        <button
          class="menu-toggle"
          type="button"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="site-menu"
        >
          <span class="menu-toggle__label" data-menu-label>Menu</span>
          <span class="menu-toggle__box" aria-hidden="true">
            <span class="menu-toggle__bar"></span>
            <span class="menu-toggle__bar"></span>
          </span>
        </button>
        <div class="nav-backdrop" data-nav-backdrop hidden></div>
        <nav class="site-nav" id="site-menu" aria-label="Primary" hidden>
          <div class="site-nav__panel">
            <header class="site-nav__head">
              <p class="nav-label">Navigate</p>
              <p class="nav-meta">Keisei Kondo</p>
            </header>
            <ul>
              <li style="--i: 0"><a href="#about"><span class="nav-index">01</span><span class="nav-link-text">About</span></a></li>
              <li style="--i: 1"><a href="#skills"><span class="nav-index">02</span><span class="nav-link-text">Skills</span></a></li>
              <li style="--i: 2"><a href="#projects"><span class="nav-index">03</span><span class="nav-link-text">Projects</span></a></li>
              <li style="--i: 3"><a href="#focus"><span class="nav-index">04</span><span class="nav-link-text">Focus</span></a></li>
              <li style="--i: 4"><a href="#contact"><span class="nav-index">05</span><span class="nav-link-text">Contact</span></a></li>
            </ul>
            <footer class="site-nav__foot">
              <span>Full-Stack Developer</span>
              <a href="mailto:keisei20001206@gmail.com">Email</a>
            </footer>
          </div>
        </nav>
      </div>
    </header>

    <main id="main-content">
      <section class="hero" aria-labelledby="hero-heading">
        <div class="hero-content" data-hero>
          <p class="hero-eyebrow">
            <span class="hero-pulse" aria-hidden="true"></span>
            Available for work
          </p>
          <h1 id="hero-heading" class="hero-title">
            <span class="visually-hidden">Full-Stack Developer</span>
            <canvas class="hero-star-title" data-hero-stars aria-hidden="true"></canvas>
          </h1>
          <div class="hero-lower" data-hero-line>
            <p class="hero-lead">
              I design and ship complete web products —
              <em>from API to interface.</em>
            </p>
            <div class="hero-actions">
              <a class="hero-cta" href="#contact">
                <span class="hero-cta__label">Start a project</span>
                <span class="hero-cta__icon" aria-hidden="true">
                  <span class="hero-cta__chevron"></span>
                </span>
              </a>
              <a class="hero-link" href="#projects">Selected work</a>
            </div>
          </div>
        </div>
        <a class="hero-scroll" href="#about" aria-label="Scroll to about">
          <span class="hero-scroll__label">Scroll</span>
          <span class="hero-scroll__line" aria-hidden="true"></span>
        </a>
      </section>

      <section class="panel" id="about" aria-labelledby="about-heading">
        <div class="panel-body about-body" data-panel data-about>
          <header class="section-head" data-reveal>
            <h2 id="about-heading">About</h2>
          </header>
          <p class="lead prose-lead" data-words>
            Full-stack developer across the whole stack.
          </p>
          <div class="prose-copy" data-prose-copy data-reveal style="--reveal-delay: 0.2s">
            <p class="copy prose-line" style="--l: 0">
              I design and ship complete web products —
              <span class="hl">REST &amp; API layers</span>,
              <span class="hl">relational data models</span>, and
              polished front-ends.
            </p>
            <p class="copy prose-line" style="--l: 1">
              Comfortable owning a feature from
              <span class="hl">schema to deployment</span>, I care about clean
              architecture and interfaces that feel effortless to use.
            </p>
          </div>
        </div>
      </section>

      <section class="panel" id="skills" aria-labelledby="skills-heading">
        <div class="panel-body panel-body--wide" data-panel>
          <header class="section-head" data-reveal>
            <h2 id="skills-heading">Skills</h2>
          </header>
          <ul class="tags" role="list">
            <li data-reveal style="--reveal-delay: 0.08s"><span class="tag">HTML</span></li>
            <li data-reveal style="--reveal-delay: 0.12s"><span class="tag">CSS</span></li>
            <li data-reveal style="--reveal-delay: 0.16s"><span class="tag">TypeScript</span></li>
            <li data-reveal style="--reveal-delay: 0.20s"><span class="tag">Node.js</span></li>
            <li data-reveal style="--reveal-delay: 0.24s"><span class="tag">Express</span></li>
            <li data-reveal style="--reveal-delay: 0.28s"><span class="tag">Astro</span></li>
            <li data-reveal style="--reveal-delay: 0.32s"><span class="tag">PostgreSQL</span></li>
            <li data-reveal style="--reveal-delay: 0.36s"><span class="tag">Three.js</span></li>
            <li data-reveal style="--reveal-delay: 0.40s"><span class="tag">Git</span></li>
            <li data-reveal style="--reveal-delay: 0.44s"><span class="tag">GitHub</span></li>
          </ul>
        </div>
        <div class="marquee" aria-hidden="true">
          <div class="marquee-track">
            <span>Full-Stack ✦ Front-End ✦ Back-End ✦ APIs ✦ Databases ✦ TypeScript ✦ Node.js ✦ UI/UX ✦</span>
            <span>Full-Stack ✦ Front-End ✦ Back-End ✦ APIs ✦ Databases ✦ TypeScript ✦ Node.js ✦ UI/UX ✦</span>
          </div>
        </div>
      </section>

      <section class="panel" id="projects" aria-labelledby="projects-heading">
        <div class="panel-body" data-panel>
          <header class="section-head" data-reveal>
            <h2 id="projects-heading">Projects</h2>
          </header>
          <p class="lead" data-words>Full-stack builds, front to back.</p>
          <ul class="project-list" role="list">
            <li class="project-row" data-reveal style="--reveal-delay: 0.16s">
              <span class="project-name">Interactive Portfolio</span>
              <span class="project-meta"><span class="hl">Astro</span> · <span class="hl">Three.js</span> · real-time WebGL scene</span>
            </li>
            <li class="project-row project-row--empty" data-reveal style="--reveal-delay: 0.22s">
              <span class="project-name">Coming soon</span>
              <span class="project-meta">Project 02 — in the works</span>
            </li>
            <li class="project-row project-row--empty" data-reveal style="--reveal-delay: 0.28s">
              <span class="project-name">Coming soon</span>
              <span class="project-meta">Project 03 — in the works</span>
            </li>
          </ul>
        </div>
      </section>

      <section class="panel" id="focus" aria-labelledby="focus-heading">
        <div class="panel-body" data-panel>
          <header class="section-head" data-reveal>
            <h2 id="focus-heading">Focus</h2>
          </header>
          <p class="lead prose-lead" data-words>Where I'm pointing next.</p>
          <div class="prose-copy" data-prose-copy data-reveal style="--reveal-delay: 0.2s">
            <p class="copy prose-line" style="--l: 0">
              <span class="hl">Type-safe APIs</span>, well-modeled databases, and front-ends that stay
              fast and accessible.
            </p>
            <p class="copy prose-line" style="--l: 1">
              I care about the full pipeline —
              <span class="hl">DX</span>, <span class="hl">performance</span>, and shipping features
              that hold up in production.
            </p>
          </div>
        </div>
      </section>

      <section class="panel gas-panel" id="contact" aria-labelledby="contact-heading">
        <div class="panel-body" data-panel>
          <header class="section-head" data-reveal>
            <h2 id="contact-heading">Contact</h2>
          </header>
          <p class="lead prose-lead" data-words>Let's build something together.</p>
          <div class="prose-copy" data-prose-copy data-reveal style="--reveal-delay: 0.2s">
            <p class="copy prose-line" style="--l: 0">
              Looking for a <span class="hl">full-stack developer</span> for your next project?
            </p>
            <p class="copy prose-line" style="--l: 1">
              Let's talk — I'll get back to you soon.
            </p>
          </div>
          <div class="contact-actions" data-reveal style="--reveal-delay: 0.16s">
            <a class="cta" href="mailto:keisei20001206@gmail.com"
              >Send message<span class="cta-arrow" aria-hidden="true"> →</span></a
            >
            <ul class="contact-links" role="list">
              <li>
                <a
                  class="contact-link"
                  href="https://www.linkedin.com/in/keisei-kondo-0bab093a3"
                  target="_blank"
                  rel="noopener noreferrer"
                  >LinkedIn</a
                >
              </li>
              <li>
                <a
                  class="contact-link"
                  href="https://github.com/keisei-dev"
                  target="_blank"
                  rel="noopener noreferrer"
                  >GitHub</a
                >
              </li>
            </ul>
          </div>
        </div>
        <p class="footer">© Keisei Kondo</p>
      </section>
    </main>

    <script>
      import '../main.ts';
    </script>
  </body>
</html>
